# Copy to .env.local (website dev) or .env.android.local (Android app build).
# Real values never go in git: .env, .env.local and .env.*.local are ignored.

# Supabase — the ONLY correct project for Fredheim. The Android build refuses
# to run if this points anywhere else (see vite.config.js).
VITE_SUPABASE_URL=https://xpjruhkjmpwxxjhwvihj.supabase.co
# Public anon key from Supabase → Project settings → API.
VITE_SUPABASE_ANON_KEY=

# Android app only: RevenueCat public Google Play SDK key (starts with goog_).
VITE_REVENUECAT_ANDROID_KEY=

# Website only: comma-separated emails with free admin access.
VITE_ADMIN_EMAILS=
