{
  "appId": "no.fredheim.app",
  "appName": "Fredheim",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#ffffff"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "contain"
    }
  }
}
